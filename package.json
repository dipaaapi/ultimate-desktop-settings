{
  "name": "ultimate-windows-desktop-settings",
  "private": true,
  "version": "2.0.0",
  "description": "Ultimate Windows Desktop Settings: a Windows settings panel on a silver rod.",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "build:preview": "tsc -b && vite build --mode preview",
